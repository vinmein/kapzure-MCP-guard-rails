{
  "upstream_url": "http://127.0.0.1:9000/mcp",
  "allowed_origins": [],
  "max_request_bytes": 65536,
  "max_response_bytes": 1048576,
  "timeout_seconds": 30,
  "max_in_flight": 32,
  "clients": {
    "demo-client": {
      "token_env": "MCP_GUARD_DEMO_TOKEN",
      "allowed_tools": ["echo"],
      "rate_limit": {"requests": 60, "window_seconds": 60}
    }
  },
  "tools": {
    "echo": {
      "input_schema": {
        "type": "object",
        "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "required": ["text"],
        "additionalProperties": false
      },
      "blocked_substrings": ["DEMO_BLOCKED_TEXT"],
      "rate_limit": {"requests": 20, "window_seconds": 60}
    }
  }
}
